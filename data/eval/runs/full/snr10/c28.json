 "turns": [
  {
   "idx": 1,
   "speaker": "A",
   "text": "हाँ, अशोक तांबे बोल रहा है।",
   "stt_ms": 366,
   "lang": "hi-IN"
  },
  {
   "idx": 2,
   "speaker": "B",
   "text": "हाँ, कौन?",
   "stt_ms": 333,
   "lang": "hi-IN"
  },
  {
   "idx": 3,
   "speaker": "A",
   "text": "पैसा कब दे रहा है? 2 महीने से ऊपर हो गए। तू सुनता ही नहीं है। फोन उठाता नहीं है। आज उठाया है तो सीधा बोल।",
   "stt_ms": 895,
   "lang": "hi-IN"
  },
  {
   "idx": 4,
   "speaker": "B",
   "text": "आप कौन बोल रहे हो? ऐसे तू-तू करके क्यों बात कर रहे हो?",
   "stt_ms": 538,
   "lang": "hi-IN"
  },
  {
   "idx": 5,
   "speaker": "A",
   "text": "सवाल मत पूछ, पैसा बोल। ज्यादा होशियारी मत दिखा, नहीं तो तेरे घर आकर तमाशा करूंगा, समझ गया?",
   "stt_ms": 794,
   "lang": "hi-IN"
  },
  {
   "idx": 6,
   "speaker": "B",
   "text": "मैं पुलिस में complaint करूंगा, ये सब record हो रहा होगा।",
   "stt_ms": 458,
   "lang": "hi-IN"
  },
  {
   "idx": 7,
   "speaker": "A",
   "text": "जा कर ले जो करना है। मेरे को Friday तक payment चाहिए। पर मेरी team को रोज report देनी पड़ती है।",
   "stt_ms": 1036,
   "lang": "hi-IN"
  },
  {
   "idx": 8,
   "speaker": "B",
   "text": "पहले ये बोलो कि आप कौन हो? कौन सी company से? मैं ऐसे किसी को पैसा नहीं दूंगा।",
   "stt_ms": 628,
   "lang": "hi-IN"
  },
  {
   "idx": 9,
   "speaker": "A",
   "text": "तारंग Finserve से रोहित। तेरा personal loan 9,500 की EMI दो महीने से pending है। Link SMS पे भेज देता हूँ। Friday तक कर दूंगा।",
   "stt_ms": 972,
   "lang": "hi-IN"
  }
 ],
