 "turns": [
  {
   "idx": 1,
   "speaker": "A",
   "text": "विनोद जी, रोहित बोल रहा हूँ।",
   "stt_ms": 494,
   "lang": "hi-IN"
  },
  {
   "idx": 2,
   "speaker": "B",
   "text": "हाँ, विनोद बोल रहा हूँ। क्या है?",
   "stt_ms": 522,
   "lang": "hi-IN"
  },
  {
   "idx": 3,
   "speaker": "A",
   "text": "और ध्यान रहे, यह call record की जा रही है। सीधी बात पर आता हूँ।",
   "stt_ms": 482,
   "lang": "hi-IN"
  },
  {
   "idx": 4,
   "speaker": "B",
   "text": "हाँ बोलो।",
   "stt_ms": 303,
   "lang": "hi-IN"
  },
  {
   "idx": 5,
   "speaker": "A",
   "text": "7,200 की EMI एक महीने से pending है, bounce भी हो चुकी है और penalty चढ़ रही है, ऐसा कब आएगा?",
   "stt_ms": 562,
   "lang": "hi-IN"
  },
  {
   "idx": 6,
   "speaker": "B",
   "text": "Madam थोड़ा रुक जाइए। अगले हफ्ते तक कुछ करता हूँ।",
   "stt_ms": 521,
   "lang": "hi-IN"
  },
  {
   "idx": 7,
   "speaker": "A",
   "text": "अगले हफ्ते, अगले हफ्ते। मेरे को आज का बोलो। बहाने मत बनाओ। आप बेवकूफ हो क्या? हर बार एक नया ड्रामा।",
   "stt_ms": 559,
   "lang": "hi-IN"
  },
  {
   "idx": 8,
   "speaker": "B",
   "text": "Sir, ऐसे क्या बोल रहे हो? इज्जत से बात कर।",
   "stt_ms": 387,
   "lang": "hi-IN"
  },
  {
   "idx": 9,
   "speaker": "A",
   "text": "इज्जत कमाई जाती है। पैसा नहीं दे सकते तो income में होना। और ज्यादा होशियारी मत दिखाओ, नहीं तो घर आके तमाशा करो।",
   "stt_ms": 495,
   "lang": "hi-IN"
  },
  {
   "idx": 10,
   "speaker": "B",
   "text": "मैं complaint करूंगा। आप, ये सब record हो रहा है ना?",
   "stt_ms": 422,
   "lang": "hi-IN"
  },
  {
   "idx": 11,
   "speaker": "A",
   "text": "जो करना है करो, मेरे को Monday तक payment चाहिए। SMS पे link आ जाएगा।",
   "stt_ms": 355,
   "lang": "hi-IN"
  }
 ],
