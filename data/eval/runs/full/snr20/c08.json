 "turns": [
  {
   "idx": 1,
   "speaker": "A",
   "text": "विनोद जी, रोहित बोल रहा हूँ, तारंग Finserv से।",
   "stt_ms": 456,
   "lang": "hi-IN"
  },
  {
   "idx": 2,
   "speaker": "B",
   "text": "हाँ, विनोद बोल रहा हूँ। क्या है?",
   "stt_ms": 429,
   "lang": "hi-IN"
  },
  {
   "idx": 3,
   "speaker": "A",
   "text": "और ध्यान रहे, यह call record की जा रही है, सीधी बात पर आता हूँ।",
   "stt_ms": 547,
   "lang": "hi-IN"
  },
  {
   "idx": 4,
   "speaker": "B",
   "text": "हाँ बोलो।",
   "stt_ms": 267,
   "lang": "hi-IN"
  },
  {
   "idx": 5,
   "speaker": "A",
   "text": "7,200 की EMI एक महीने से pending है, bounce भी हो चुकी है और penalty चढ़ रही है, पैसा कब आएगा?",
   "stt_ms": 452,
   "lang": "hi-IN"
  },
  {
   "idx": 6,
   "speaker": "B",
   "text": "Sir, धंधा बंद पड़ा है, थोड़ा रुक जाइए, अगले हफ्ते तक कुछ करता हूँ।",
   "stt_ms": 403,
   "lang": "hi-IN"
  },
  {
   "idx": 7,
   "speaker": "A",
   "text": "अगले हफ्ते, अगले हफ्ते, मेरे को आज का बोलो, बहाने मत बनाओ, आप बेवकूफ हो क्या? हर बार एक नया drama",
   "stt_ms": 504,
   "lang": "hi-IN"
  },
  {
   "idx": 8,
   "speaker": "B",
   "text": "Sir, ऐसे क्या बोल रहे हो? इज्जत से बात करो।",
   "stt_ms": 468,
   "lang": "hi-IN"
  },
  {
   "idx": 9,
   "speaker": "A",
   "text": "इज्जत कमाई जाती है। पैसा नहीं दे सकते तो निकम्मे हो आप, और ज़्यादा होशियारी मत दिखा, नहीं तो घर आके तमाशा करूँगा।",
   "stt_ms": 663,
   "lang": "hi-IN"
  },
  {
   "idx": 10,
   "speaker": "B",
   "text": "मैं complaint करूँगा आपकी। यह सब record हो रहा है ना?",
   "stt_ms": 421,
   "lang": "hi-IN"
  },
  {
   "idx": 11,
   "speaker": "A",
   "text": "जो करना है करो, मेरे को Monday तक payment चाहिए, SMS पे link आ जाएगा।",
   "stt_ms": 505,
   "lang": "hi-IN"
  }
 ],
