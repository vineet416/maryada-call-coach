# Copy to .env (never commit .env).
# Deployed: leave these empty. Every live call uses the visitor's own keys, entered on the Settings page.
# Local development and the evaluation tools only: set SERVER_KEYS_ENABLED=true and fill both keys.
SERVER_KEYS_ENABLED=false
# Gnani speech key
GNANI_API_KEY_ID=

# Local language model key (Euri)
EURI_API_KEY=
EURI_API_KEY2=


# Defaults below are fine; change only if the docs say so.
EURI_BASE_URL=https://api.euron.one/api/v1/euri
LLM_MODEL=gpt-5.4-mini
LLM_FALLBACK_MODEL=gpt-4.1-mini
STT_MODE=realtime
MAX_LIVE_SESSIONS=3
REPLAY_ONLY=false
ALLOWED_ORIGINS=http://localhost:5173
PACE=1.0

LLM_HTTP2=true
SKIP_LLM_MAX_WORDS=8
CHECK_GRANULARITY=segment
RECORD_RUNS=false
SESSION_MAX_S=200
