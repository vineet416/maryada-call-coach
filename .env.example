# Copy to .env (never commit .env). Only the first two are secrets you must fill in.
GNANI_API_KEY_ID=
EURI_API_KEY=

# Defaults below are fine; change only if the docs say so.
EURI_BASE_URL=https://api.euron.one/api/v1/euri
LLM_MODEL=gpt-5.4-mini
LLM_FALLBACK_MODEL=gpt-4.1-mini
STT_MODE=realtime
DAILY_SESSION_CAP=60
REPLAY_ONLY=false
ALLOWED_ORIGINS=http://localhost:5173
PACE=1.0

LLM_HTTP2=true
COACH_MODE=hold
CHECK_GRANULARITY=segment
RECORD_RUNS=false
